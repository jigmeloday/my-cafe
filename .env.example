DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Email sending (resend.com). Without a key, emails are printed to the server console in development.
RESEND_API_KEY="re_xxxxxxxx"
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="Nook <onboarding@resend.dev>"

# Image storage (S3-compatible: Neon Storage). Images stay in a private bucket and are served through /api/media.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=images

# The public address of the site (used for sitemap, canonical links and share cards). Required in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
