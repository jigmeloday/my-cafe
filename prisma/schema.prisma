generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  BUSINESS_OWNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum PromotionType {
  DEAL
  SALE
  EVENT
  PRODUCT
  SERVICE
  GIVEAWAY
  ANNOUNCEMENT
}

/// What a visitor did with a promotion. Saves come from Favorite instead, so they stay in step with the heart button.
/// Why someone reported an ad (a promotion or a banner).
enum ReportReason {
  MISLEADING
  WRONG_PRICE
  SCAM
  SPAM
  OFFENSIVE
  CLOSED
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ReportDecision {
  DISMISSED
  WARNED
  REMOVED
}

/// Where a business's identity check (KYC) stands. A business can send a new request after a rejection.
enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether someone at Nook has dealt with a message from the Contact page.
enum MessageStatus {
  OPEN
  DONE
}

enum PromotionEventType {
  VIEW
  CLICK
}

enum PromotionStatus {
  DRAFT
  PUBLISHED
  ENDED
}

enum CoinTransactionType {
  PURCHASE
  PUBLISH
  EMAIL_CAMPAIGN
  BANNER
  FEATURED
  TOP_RANK
  REFUND
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  emailVerified      Boolean        @default(false)
  image              String?
  /// When a verification email was last sent, so people can't be spammed with them.
  verificationSentAt DateTime?
  role               Role           @default(USER)
  status             AccountStatus  @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  businesses         Business[]
  sessions           Session[]
  accounts           Account[]
  profile            Profile?
  favorites          Favorite[]
  follows            Follow[]
  notifications      Notification[]
  reports            Report[]
}

// The next three models are the tables Better Auth needs.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hashed password for email sign-in.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  promotions Promotion[]
}

model Business {
  id               String            @id @default(cuid())
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  name             String
  slug             String            @unique
  tagline          String            @default("")
  description      String            @default("")
  phone            String            @default("")
  email            String            @default("")
  website          String            @default("")
  addressLine1     String            @default("")
  addressLine2     String            @default("")
  town             String            @default("")
  dzongkhag        String            @default("")
  postalCode       String            @default("")
  facebook         String            @default("")
  instagram        String            @default("")
  tiktok           String            @default("")
  logoKey          String            @default("")
  coverKey         String            @default("")
  gallery          String[]
  hours            Json?
  services         String[]
  products         String[]
  status           BusinessStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  promotions       Promotion[]
  wallet           Wallet?
  banners          Banner[]
  featuredBookings FeaturedBooking[]
  kycSubmissions   KycSubmission[]

  @@index([ownerId])
}

model Promotion {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  slug             String            @unique
  title            String
  type             PromotionType
  status           PromotionStatus   @default(DRAFT)
  discount         String            @default("")
  description      String            @default("")
  location         String            @default("")
  ctaType          String            @default("VIEW_OFFER")
  ctaUrl           String            @default("")
  photos           String[]
  events           PromotionEvent[]
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  banners          Banner[]
  featuredBookings FeaturedBooking[]
  reports          Report[]
  /// Set when an admin took it down after a report. It is never shown again and the owner can\'t republish it.
  removedAt        DateTime?

  @@index([businessId])
  @@index([status, type])
}

// Coins are whole numbers. `balance` is only ever changed together with a CoinTransaction row.
model Wallet {
  id           String            @id @default(cuid())
  businessId   String            @unique
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  balance      Int               @default(0)
  transactions CoinTransaction[]
}

model CoinTransaction {
  id           String              @id @default(cuid())
  walletId     String
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         CoinTransactionType
  /// Signed whole coins: positive adds, negative spends.
  amount       Int
  balanceAfter Int
  description  String
  /// The payment provider\'s id for a purchase. Unique, so a repeated webhook can never credit twice.
  reference    String?             @unique
  createdAt    DateTime            @default(now())

  @@index([walletId, createdAt])
}

// Extra details a customer chooses to share. Created the first time they save something.
model Profile {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthday         DateTime? @db.Date
  gender           String    @default("")
  phone            String    @default("")
  preferredContact String    @default("email")
  addressLine1     String    @default("")
  addressLine2     String    @default("")
  town             String    @default("")
  dzongkhag        String    @default("")
  postalCode       String    @default("")
  interests        String[]

  // How we may reach them (the app only emails or texts people who switched these on).
  notifyEmail          Boolean   @default(true)
  notifySms            Boolean   @default(false)
  notifyPush           Boolean   @default(true)
  topicFollowed        Boolean   @default(true)
  topicWeekend         Boolean   @default(true)
  topicNewPlaces       Boolean   @default(false)
  topicEnding          Boolean   @default(true)
  topicBirthday        Boolean   @default(true)
  allowPersonalisation Boolean   @default(true)
  marketingConsent     Boolean   @default(false)
  /// When promotional consent was last given. Null while it is off.
  marketingConsentAt   DateTime?

  updatedAt DateTime @updatedAt
}

// Saved promotions and followed businesses are keyed by their page address (e.g. "/promotions/pizza-fridays")
// for now, because the public site still runs on sample data. When promotions and businesses move into
// the database, these become proper links to those rows.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  href      String
  createdAt DateTime @default(now())

  @@id([userId, href])
  @@index([userId, createdAt])
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  href      String
  createdAt DateTime @default(now())

  @@id([userId, href])
  @@index([userId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

// A record of what admins did. It has no links to other tables on purpose: the entry must survive
// after the person it is about (or the admin who did it) is deleted, so names are copied in.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  /// e.g. "user.suspend", "user.unsuspend", "user.delete"
  action      String
  targetId    String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

/// One view or click on a promotion. Counted by day for analytics.
model PromotionEvent {
  id          String             @id @default(cuid())
  promotionId String
  promotion   Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type        PromotionEventType
  /// Where the visitor came from: "discover", "deals", "events", "search" or "other".
  source      String             @default("other")
  createdAt   DateTime           @default(now())

  @@index([promotionId, createdAt])
  @@index([createdAt])
}

/// One failed or throttled attempt (sign-in, sign-up...), kept briefly so too many in a short time can be refused.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// A paid homepage banner. It runs from `startsAt` to `endsAt` (both days included) and is paid for up front in coins.
model Banner {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Where the banner leads. Empty means the business's own page.
  promotionId String?
  promotion   Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  title       String
  description String        @default("")
  imageKey    String
  startsAt    DateTime      @db.Date
  endsAt      DateTime      @db.Date
  /// Coins paid for the whole run.
  coins       Int
  createdAt   DateTime      @default(now())
  events      BannerEvent[]
  reports     Report[]
  /// Set when an admin took it down after a report. Coins are not refunded.
  removedAt   DateTime?

  @@index([businessId])
  @@index([startsAt, endsAt])
}

/// One time a banner was shown (VIEW) or clicked (CLICK).
model BannerEvent {
  id        String             @id @default(cuid())
  bannerId  String
  banner    Banner             @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  type      PromotionEventType
  createdAt DateTime           @default(now())

  @@index([bannerId, createdAt])
}

/// A paid place in the home page's "Featured" row. Each day has a limited number of places (see lib/featured.ts).
model FeaturedBooking {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// First and last day it is featured, both included.
  startsAt    DateTime  @db.Date
  endsAt      DateTime  @db.Date
  /// Coins paid for the whole run.
  coins       Int
  createdAt   DateTime  @default(now())

  @@index([startsAt, endsAt])
  @@index([promotionId])
  @@index([businessId])
}

/// Someone reporting an ad. Exactly one of `promotionId` and `bannerId` is set. A person can report an ad once.
model Report {
  id           String          @id @default(cuid())
  reporterId   String
  reporter     User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  promotionId  String?
  promotion    Promotion?      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  bannerId     String?
  banner       Banner?         @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  reason       ReportReason
  details      String          @default("")
  status       ReportStatus    @default(OPEN)
  decision     ReportDecision?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@unique([reporterId, promotionId])
  @@unique([reporterId, bannerId])
  @@index([status, createdAt])
  @@index([promotionId])
  @@index([bannerId])
}

/// A business owner's request to be verified. The documents are private files in the bucket under kyc/<businessId>/
/// and are only ever opened by an admin. Personal details here are for the reviewing admin only.
model KycSubmission {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status        KycStatus @default(PENDING)
  /// Full name as written on the ID.
  ownerName     String
  /// National ID (CID) number.
  idNumber      String
  licenseNumber String
  idDocKey      String
  licenseDocKey String
  /// Optional photo of the shop front.
  premisesKey   String    @default("")
  /// Why a rejected request was rejected. Shown to the owner.
  reviewNote    String    @default("")
  submittedAt   DateTime  @default(now())
  reviewedById  String?
  reviewedAt    DateTime?

  @@index([businessId, submittedAt])
  @@index([status, submittedAt])
}

/// A message sent from the public Contact page. Anyone can send one, signed in or not. We keep the name, email
/// and text only to reply, and do not store the sender's IP address.
model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  /// One of the topics on the Contact page: question, business, verification, account, privacy, other.
  topic       String
  message     String
  /// Set when the sender was logged in.
  userId      String?
  status      MessageStatus @default(OPEN)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}
